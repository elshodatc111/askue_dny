# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zgartiring (setup.bat buni avtomatik qiladi)
SECRET_KEY=bu-yerga-uzun-tasodifiy-matn-yozing
DEBUG=0

# Cloudflare orqali chiqariladigan domen (https bilan). Bir nechta bo'lsa vergul bilan ajrating.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
HTTPS=0

# MySQL
DB_ENGINE=mysql
DB_NAME=hodimlar
DB_USER=root
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=3306

# Batafsil (nomma-nom) ma'lumotlar necha kun saqlanadi. Jamlama statistika doim saqlanadi.
DETAIL_RETENTION_DAYS=180
