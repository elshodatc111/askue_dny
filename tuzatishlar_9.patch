+{% verbatim %}
+(function () {
+  var root = document.getElementById('tg-sahifa'); if (!root) return;
+  var URL_ = root.dataset.tekshir;
+  function toast(t, tur, key) { if (window.bildirish) window.bildirish(t, tur, key); }
+  var TUR = { ok: 'success', ogoh: 'warning', xato: 'error' };
+  var MATN = { ok: 'Tayyor', ogoh: 'Ogohlantirish', xato: 'Xato' };
+  var CLS = { ok: 'g', ogoh: 'y', xato: 'r' };
+  function belgi(el, d) { if (!el) return; el.className = 'chip ' + (CLS[d.holat] || '') + (el.classList.contains('tek-g') ? ' tek-g' : ''); el.id = el.id || ''; el.textContent = MATN[d.holat] || '?'; el.title = d.matn || '';
+    if (el.classList.contains('tek-g')) { var sm = el.parentNode.querySelector('.tek-matn'); if (!sm) { sm = document.createElement('div'); sm.className = 'tek-matn muted'; sm.style.cssText = 'font-size:11.5px;line-height:1.35;margin-top:4px;max-width:260px;white-space:normal'; el.parentNode.appendChild(sm); } sm.textContent = (d.matn || '').replace(/^«[^»]*»:\s*/, ''); } }
+  function sora(qs) {
+    return fetch(URL_ + '?' + qs, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
+      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
+      .catch(function (e) { return { holat: 'xato', matn: 'Tekshirib bo\'lmadi: ' + e.message }; });
+  }
+  function botTek(jim) {
+    var el = document.getElementById('tek-bot'); if (el) { el.className = 'chip'; el.textContent = 'Tekshirilmoqda…'; }
+    return sora('tur=bot').then(function (d) { belgi(el, d); if (!jim) toast(d.matn, TUR[d.holat]); return d; });
+  }
+  function guruhTek(tr, jim) {
+    var el = tr.querySelector('.tek-g'); if (el) { el.className = 'chip tek-g'; el.textContent = 'Tekshirilmoqda…'; el.title = ''; var o = el.parentNode.querySelector('.tek-matn'); if (o) o.textContent = ''; }
+    return sora('tur=guruh&id=' + tr.dataset.guruh).then(function (d) { belgi(el, d); if (!jim) toast(d.matn, TUR[d.holat]); return d; });
+  }
+  function hammasi(jim) {
+    var qatorlar = Array.prototype.slice.call(document.querySelectorAll('tr[data-guruh]'));
+    return botTek(true).then(function (b) {
+      if (b.holat === 'xato') { if (!jim) toast(b.matn, 'error'); else toast(b.matn, 'error', 'tek_bot'); qatorlar.forEach(function (tr) { belgi(tr.querySelector('.tek-g'), { holat: 'xato', matn: 'Bot ishlamayapti' }); }); return; }
+      var i = 0, xato = 0, ogoh = 0;
+      (function keyingi() {
+        if (i >= qatorlar.length) {
+          if (!qatorlar.length) return;
+          if (xato) toast(xato + ' ta guruhda muammo bor. «Bot holati» ustunida sababini ko\'ring.', 'error');
+          else if (ogoh) toast('Barcha guruhlar topildi, ' + ogoh + ' tasida botni administrator qilish tavsiya etiladi.', 'warning');
+          else if (!jim) toast('Bot va barcha guruhlar tekshirildi: hammasi joyida.', 'success');
+          return;
+        }
+        guruhTek(qatorlar[i++], true).then(function (d) { if (d.holat === 'xato') xato++; else if (d.holat === 'ogoh') ogoh++; keyingi(); });
+      })();
+    });
+  }
+  var bb = document.getElementById('tek-bot-btn'); if (bb) bb.addEventListener('click', function () { bb.disabled = true; botTek(false).then(function () { bb.disabled = false; }); });
+  var hb = document.getElementById('tek-hamma'); if (hb) hb.addEventListener('click', function () { hb.disabled = true; hammasi(false).then(function () { setTimeout(function () { hb.disabled = false; }, 600); }); });
+  document.addEventListener('click', function (e) {
+    var b = e.target.closest('.tek-btn'); if (!b) return;
+    b.disabled = true; guruhTek(b.closest('tr'), false).then(function () { b.disabled = false; });
+  });
+  // har bir amalda tugma «bajarilmoqda» holatiga o'tadi (natija sahifa yangilangach xabar bo'lib chiqadi)
