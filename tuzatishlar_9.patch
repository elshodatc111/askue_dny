+def tekshir(request):
+    """Bot (tur=bot) yoki guruh (tur=guruh&id=..) holatini Telegram orqali tekshiradi. JSON: holat (ok|ogoh|xato) va matn."""
+    sz = TelegramSozlama.olish()
