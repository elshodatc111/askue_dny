+.toasts { position: fixed; top: 16px; right: 16px; z-index: 100; display: flex; flex-direction: column; gap: 10px; width: min(420px, calc(100vw - 24px)); }
+.toast { position: relative; overflow: hidden; display: flex; align-items: flex-start; gap: 12px; padding: 14px 14px 16px 14px; border-radius: 14px; border: 1px solid var(--tb); background: var(--tbg); color: var(--tc); box-shadow: 0 10px 30px rgba(15,23,42,.14); animation: slideIn .35s ease both; font-size: 13.5px; line-height: 1.45; --tb: #bfdbfe; --tbg: #eff6ff; --tc: #1e3a8a; --ti: #3b82f6; }
