 /* xabarlar */
-.toasts { position: fixed; top: 16px; right: 16px; z-index: 100; display: flex; flex-direction: column; gap: 8px; max-width: 420px; }
-.toast { padding: 12px 16px; border-radius: 12px; background: var(--card); border-left: 4px solid var(--brand); box-shadow: var(--shadow); animation: slideIn .35s ease both; }
