+.toast.error { --tb: #fecaca; --tbg: #fef2f2; --tc: #991b1b; --ti: #ef4444; }
+.toast.warning { --tb: #fde68a; --tbg: #fffbeb; --tc: #92400e; --ti: #f59e0b; }
